{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "起飞",
  "version": "0.1.0",
  "identifier": "com.wtmedia.desktop",
  "build": {
    "frontendDist": "../.generated/frontend",
    "devUrl": "http://127.0.0.1:5174",
    "beforeDevCommand": "cd ../wt-media-cloud/web && npm run dev:desktop",
    "beforeBuildCommand": "bash scripts/prepare-release-inputs.sh"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "起飞 · 内容运营平台",
        "width": 1280,
        "height": 800,
        "create": false
      }
    ],
    "security": {}
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.png", "icons/icon.icns", "icons/icon.ico"],
    "targets": "all",
    "externalBin": ["binaries/wt-media-agent"],
    "resources": {
      "resources/desktop.production.toml": "resources/desktop.production.toml",
      "../.generated/agent-config/": "config/",
      "../.generated/sidecar-manifest.json": "sidecar-manifest.json"
    },
    "macOS": {
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installerHooks": "./windows/installer-hooks.nsh"
      }
    }
  }
}
