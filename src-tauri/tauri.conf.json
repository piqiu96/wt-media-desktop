{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WT Media",
  "version": "0.1.0",
  "identifier": "com.wtmedia.desktop",
  "build": {
    "frontendDist": "../.generated/frontend",
    "devUrl": "http://127.0.0.1:5174",
    "beforeDevCommand": "cd ../../wt-media-cloud/web && npm run dev:desktop",
    "beforeBuildCommand": "bash scripts/prepare-release-sidecar.sh && bash ../wt-media-workspace/scripts/build-desktop.sh"
  },
  "app": {
    "windows": [
      {
        "title": "WT Media",
        "width": 1280,
        "height": 800
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:18080; style-src 'self' 'unsafe-inline'; img-src 'self' https:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/wt-media-agent"],
    "resources": ["resources/*.toml"],
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
