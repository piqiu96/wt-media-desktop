{
  "name": "wt-media-desktop",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "bootstrap": "npm ci",
    "dev": "vite --host 127.0.0.1 --port 5174 --strictPort",
    "start": "node scripts/start-dev.mjs",
    "stop": "node scripts/stop-dev.mjs",
    "test": "npm run verify",
    "lint": "npm run typecheck && cargo fmt --check",
    "generate": "npm run verify:scripts",
    "build": "npm run web:build && npm run tauri:build",
    "package": "tauri build",
    "verify": "npm run verify:scripts && node scripts/health-check.mjs && npm run typecheck && cargo test --workspace",
    "verify:scripts": "node scripts/verify-real-scripts.mjs",
    "health": "node scripts/health-check.mjs && node scripts/health-dev.mjs",
    "typecheck": "vue-tsc --noEmit",
    "web:build": "vite build",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vue-tsc": "^3.0.0"
  }
}
